{
  "redirects": [
    {
      "source": "https://www.caboshandyman.com/:path*",
      "destination": "https://caboshandyman.com/:path*",
      "permanent": true,
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/analyze-parts.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/feedback-chat.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/send-contact-email.js": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ]
}